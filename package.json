{
  "name": "portfoliocheck",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "dev:next": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "test:portfolio-file": "tsc --module commonjs --target es2020 --esModuleInterop --skipLibCheck --outDir /tmp/portfoliocheck-test app/portfolio-file.ts tests/portfolio-file.test.ts && node /tmp/portfoliocheck-test/tests/portfolio-file.test.js"
  },
  "dependencies": {
    "next": "^15.5.19",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "devDependencies": {
    "@types/node": "22.15.32",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "typescript": "5.8.3"
  }
}
